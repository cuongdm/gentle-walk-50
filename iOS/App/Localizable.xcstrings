    "We don't have accounts, servers, ads or tracking. We don't collect or sell your data." : {
      "comment" : "A description of the app's privacy policy.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle Walk không có tài khoản, máy chủ, quảng cáo hay theo dõi. Dữ liệu của bạn không bị thu thập hay bán đi."
          }
        }
      }
    },
    "We hear you. Here a calm voice sets the pace." : {
      "localizations" : {
        "vi" : {
