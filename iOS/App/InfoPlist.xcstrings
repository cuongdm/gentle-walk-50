    "NSHealthShareUsageDescription" : {
      "comment" : "Apple Health read permission (S16). Steps feed the Progress card and the busy-day suggestion on Today; the journey runs on active minutes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing reads your step count to show your everyday activity in Progress and to suggest a lighter session on busy days."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing đọc số bước để hiện mức vận động hằng ngày ở mục Tiến bộ và gợi ý buổi nhẹ hơn vào ngày bạn đi lại nhiều."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Apple Health write permission (S16).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing saves your walks and exercise sessions to Apple Health."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing lưu các buổi đi bộ và buổi tập của bạn vào Apple Health."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission, asked only in Outdoor prep (S10b).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing uses your location only during outdoor walks to measure distance and draw your route. It stays on this phone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing chỉ dùng vị trí của bạn khi đi bộ ngoài trời để đo quãng đường và vẽ lộ trình. Dữ liệu này chỉ nằm trên điện thoại này."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Motion permission, asked when the user picks \"Held to my chest\" or walks outdoors without location.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing uses motion to count your sit-to-stands while your phone is held to your chest, and to measure outdoor walks without location."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good Footing dùng cảm biến chuyển động để đếm số lần bạn ngồi xuống đứng lên khi giữ điện thoại trước ngực, và để đo buổi đi bộ ngoài trời khi không dùng vị trí."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
