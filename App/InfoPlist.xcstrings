{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "App name under the home screen icon. Working name until the store name is chosen (backlog M11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Walk"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Apple Health read permission (S16). Steps only feed the Progress card; the journey runs on active minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Walk reads your step count to show your everyday activity in Progress."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Apple Health write permission (S16).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Walk saves your walks and exercise sessions to Apple Health."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "comment": "Motion permission, asked when the user picks \"Held to my chest\" or walks outdoors without location.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Walk uses motion to count your sit-to-stands while your phone is held to your chest, and to measure outdoor walks without location."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location permission, asked only in Outdoor prep (S10b).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle Walk uses your location only during outdoor walks to measure distance and draw your route. It stays on this phone."
          }
        }
      }
    }
  },
  "version": "1.0"
}